{{ 'community-coffee.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #cc-strip-{{ section.id }} { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; padding: 2px 0; }
  @media (min-width: 750px) { #cc-strip-{{ section.id }} { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); } }
  #cc-strip-{{ section.id }} img { width: 100%; display: block; aspect-ratio: {{ section.settings.ratio }}; object-fit: cover; }
  {%- for block in section.blocks -%}
    #cc-strip-{{ section.id }} .cc-strip__{{ block.id }} img { object-position: {{ block.settings.focal }}; }
  {%- endfor -%}
{%- endstyle -%}

<section id="cc-strip-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}
      <div class="cc-strip__{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 1200 | image_tag: sizes: '33vw', widths: '400,700,1200', alt: block.settings.image.alt }}</div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "CC Photo strip",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "ratio", "label": "Crop", "default": "4/3", "options": [
      { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "3/2", "label": "Landscape 3:2" }, { "value": "16/9", "label": "Wide 16:9" } ] }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "select", "id": "focal", "label": "Focal point", "default": "center", "options": [
        { "value": "center", "label": "Centre" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" } ] } ] }
  ],
  "presets": [{ "name": "CC Photo strip", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] }]
}
{% endschema %}
