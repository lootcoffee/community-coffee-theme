{{ 'community-coffee.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #cc-board-{{ section.id }} { background: {{ section.settings.bg }}; padding: clamp(48px,7vw,96px) var(--gutter-mobile); }
  #cc-board-{{ section.id }} .cc-board__inner { max-width: var(--max-content); margin: 0 auto; }
  #cc-board-{{ section.id }} .cc-board__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-5); margin-bottom: var(--space-6); flex-wrap: wrap; }
  #cc-board-{{ section.id }} h2 { font-family: var(--font-display); text-transform: uppercase; letter-spacing: var(--display-tracking); line-height: var(--display-leading); font-size: var(--display-md); margin: 0; }
  #cc-board-{{ section.id }} .cc-board__stamp { font-family: var(--font-narrow); font-size: var(--label-sm); font-weight: 700; text-transform: uppercase; letter-spacing: var(--label-tracking-wide); border: 1.5px solid var(--red-500); color: var(--red-500); border-radius: 999px; padding: 6px var(--space-4); }
  #cc-board-{{ section.id }} .cc-board__grid { display: grid; gap: var(--space-7); grid-template-columns: 1fr; }
  @media (min-width: 750px) { #cc-board-{{ section.id }} { padding-left: var(--gutter-desktop); padding-right: var(--gutter-desktop); } #cc-board-{{ section.id }} .cc-board__grid { grid-template-columns: repeat({{ section.settings.columns }}, 1fr); } }
  #cc-board-{{ section.id }} .cc-board__col-title { font-family: var(--font-narrow); font-size: var(--label-md); font-weight: 700; text-transform: uppercase; letter-spacing: var(--label-tracking-wide); padding-bottom: var(--space-2); border-bottom: 1.5px solid var(--red-500); margin-bottom: var(--space-4); }
  #cc-board-{{ section.id }} .cc-board__row { display: flex; align-items: baseline; gap: var(--space-3); padding: var(--space-2) 0; }
  #cc-board-{{ section.id }} .cc-board__name { font-family: var(--font-narrow); font-size: var(--label-md); text-transform: uppercase; letter-spacing: var(--label-tracking); }
  #cc-board-{{ section.id }} .cc-board__dots { flex: 1; border-bottom: 1px dotted var(--ink-200); transform: translateY(-3px); }
  #cc-board-{{ section.id }} .cc-board__price { font-family: var(--font-mono); font-size: var(--mono-md); letter-spacing: var(--mono-tracking); font-variant-numeric: tabular-nums; }
  #cc-board-{{ section.id }} .cc-board__note { font-family: var(--font-body); font-size: var(--body-sm); color: var(--text-muted); margin-top: var(--space-1); }
  #cc-board-{{ section.id }} .cc-board__foot { margin-top: var(--space-6); }
{%- endstyle -%}

<section id="cc-board-{{ section.id }}">
  <div class="cc-board__inner">
    <div class="cc-board__head">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.stamp != blank -%}<span class="cc-board__stamp">{{ section.settings.stamp }}</span>{%- endif -%}
    </div>
    <div class="cc-board__grid">
      {%- for block in section.blocks -%}
        <div class="cc-board__col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}<div class="cc-board__col-title">{{ block.settings.title }}</div>{%- endif -%}
          {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign parts = line | strip | split: '|' -%}
            {%- if parts.size > 0 and parts[0] != blank -%}
              <div class="cc-board__row">
                <span class="cc-board__name">{{ parts[0] | strip }}</span>
                <span class="cc-board__dots"></span>
                <span class="cc-board__price">{{ parts[1] | strip }}</span>
              </div>
              {%- if parts[2] != blank -%}<div class="cc-board__note">{{ parts[2] | strip }}</div>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="cc-board__foot"><a class="button button--secondary" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CC Menu board",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the board today" },
    { "type": "text", "id": "stamp", "label": "Stamp badge", "default": "Until 2pm" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F1EEE7" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    { "type": "column", "name": "Menu column", "settings": [
      { "type": "text", "id": "title", "label": "Column title", "default": "Coffee" },
      { "type": "textarea", "id": "items", "label": "Items", "info": "One per line: Name | Price | Optional note", "default": "Espresso | 4.0\nFlat white | 5.0\nBatch brew | 4.5 | Changes weekly" }
    ] }
  ],
  "presets": [{
    "name": "CC Menu board",
    "blocks": [ { "type": "column" }, { "type": "column" }, { "type": "column" } ]
  }]
}
{% endschema %}
