{{ 'community-coffee.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #cc-hero-{{ section.id }} { position: relative; display: grid; align-items: end; min-height: {{ section.settings.height }}px; background: var(--ink-900); overflow: hidden; }
  #cc-hero-{{ section.id }} .cc-hero__media { position: absolute; inset: 0; }
  #cc-hero-{{ section.id }} .cc-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.focal }}; display: block; }
  #cc-hero-{{ section.id }} .cc-hero__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(18,18,18,.78) 0%, rgba(18,18,18,.35) 45%, rgba(18,18,18,.08) 100%); }
  #cc-hero-{{ section.id }} .cc-hero__inner { position: relative; max-width: var(--cc-page, 1200px); margin: 0 auto; width: 100%; padding: var(--space-8) var(--gutter-mobile); color: #fff; }
  #cc-hero-{{ section.id }} .cc-hero__title { font-family: var(--font-display); text-transform: uppercase; letter-spacing: var(--display-tracking); line-height: 0.95; font-size: clamp(40px, 6.4vw, 96px); margin: 0; color: #fff; max-width: {{ section.settings.heading_width }}ch; text-wrap: balance; }
  #cc-hero-{{ section.id }} .cc-hero__eyebrow { margin-bottom: var(--space-3); color: #fff; }
  #cc-hero-{{ section.id }} .cc-hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  #cc-hero-{{ section.id }} .cc-hero__ctas .button--secondary { color: #fff; border-color: #fff; background: transparent; }
  #cc-hero-{{ section.id }} .cc-hero__ctas .button--secondary:hover { background: #fff; color: var(--ink-900); }
  @media (min-width: 750px) { #cc-hero-{{ section.id }} .cc-hero__inner { padding: var(--space-9) var(--gutter-desktop); } }
{%- endstyle -%}

<section id="cc-hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="cc-hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: sizes: '100vw', widths: '750,1100,1500,2000,2400', loading: 'eager', alt: section.settings.image.alt }}
    </div>
    <div class="cc-hero__scrim"></div>
  {%- endif -%}
  <div class="cc-hero__inner">
    {%- if section.settings.eyebrow != blank -%}<div class="cc-eyebrow cc-hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="cc-hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
    <div class="cc-hero__ctas">
      {%- if section.settings.cta_1_label != blank -%}<a class="button" href="{{ section.settings.cta_1_link | default: '#' }}">{{ section.settings.cta_1_label }}</a>{%- endif -%}
      {%- if section.settings.cta_2_label != blank -%}<a class="button button--secondary" href="{{ section.settings.cta_2_link | default: '#' }}">{{ section.settings.cta_2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CC Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Subiaco · Perth" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coffee, done every single morning" },
    { "type": "range", "id": "height", "label": "Minimum height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "heading_width", "label": "Headline line length", "min": 12, "max": 40, "step": 1, "unit": "ch", "default": 18 },
    { "type": "select", "id": "focal", "label": "Photo focal point", "default": "center", "options": [
      { "value": "center", "label": "Centre" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" } ] },
    { "type": "text", "id": "cta_1_label", "label": "Primary button", "default": "See the menu" },
    { "type": "url", "id": "cta_1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_2_label", "label": "Secondary button", "default": "Find us" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "CC Hero" }]
}
{% endschema %}
